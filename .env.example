# Copy to .env (git-ignored). Local development values only.
MLFLOW_TRACKING_URI=http://localhost:5001
PREFECT_API_URL=http://localhost:4200/api

# Stream artifacts through the tracking server. MLflow 3.16 otherwise hands clients presigned
# S3 URLs, and locally those point at http://seaweedfs:8333, a hostname that only exists
# inside Docker. On AWS, presigned S3 URLs are reachable, so these can be removed there.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false

# Silence MLflow's "load the tracing skill" hint printed on import.
MLFLOW_DISABLE_AGENT_HINT=1
