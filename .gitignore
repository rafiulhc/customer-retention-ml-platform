# Python
__pycache__/
*.py[oc]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Secrets
.env

# Data and models: tracked with DVC / MLflow instead
data/raw/*
data/processed/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep
mlruns/
*.joblib
*.pkl

# Notebooks' saved outputs can leak data; keep notebooks small
.ipynb_checkpoints/

# OS / editors
.DS_Store

# Generated reports (cross-validation results etc.); MLflow tracks runs from module 4
reports/
requirements-audit.txt

# Terraform: state holds resource details (and can hold secrets); plans and providers are local
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/terraform.tfvars
infra/terraform/*.tfplan
infra/terraform/tfplan
